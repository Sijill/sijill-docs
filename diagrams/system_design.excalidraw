      "originalText": "History",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1YRYUTVNbLnV-_V9dOVG_",
      "type": "text",
      "x": 671.8868477203964,
      "y": 607.5853478644987,
      "width": 2040.7904520477725,
      "height": 522.6094818814565,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 1173542973,
      "version": 643,
      "versionNonce": 819700145,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765005187570,
      "link": null,
      "locked": false,
      "text": "A patient, visits a X hospital for chest pain. \nHe’s prescribed medication and referred for a blood test. \nTime later, he visits a different hospital for follow-up. \nThe new doctor has no access to the patient's previous records/history.\nThis leads to:\n- Repeated tests\n- Risk of misdiagnosis\n- Poor continuity of care",
      "fontSize": 52.26094818814565,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A patient, visits a X hospital for chest pain. \nHe’s prescribed medication and referred for a blood test. \nTime later, he visits a different hospital for follow-up. \nThe new doctor has no access to the patient's previous records/history.\nThis leads to:\n- Repeated tests\n- Risk of misdiagnosis\n- Poor continuity of care",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Kk-vEvz8qArVFEIdAsj6Q",
      "type": "text",
      "x": 582.6770328680973,
      "y": 2155.4738513129355,
      "width": 747.3316299739303,
      "height": 65.32618523518207,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 1131085395,
      "version": 814,
      "versionNonce": 359484895,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765005187570,
      "link": null,
      "locked": false,
      "text": "II. Our Solution (SIJILL) ",
      "fontSize": 52.26094818814565,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "II. Our Solution (SIJILL) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DWzRAOOg9D3WQQ-nSNsfZ",
      "type": "text",
      "x": 698.9781949891753,
      "y": 2269.0169827931322,
      "width": 2040.7904520477725,
      "height": 587.9356671166386,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 74185341,
      "version": 1164,
      "versionNonce": 1027490705,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765005187570,
      "link": null,
      "locked": false,
      "text": "a unified, portable, and secure EHR platform that creates a lifelong\ndigital health record for every patient, accessible across all \nhealthcare providers.\n\n- Single Source of Truth: All medical encounters, prescriptions, \n  lab results,and imaging reports stored in one secure profile.\n\n- Patient-Controlled Access: Patients grant temporary access to doctors\n  via OTP.",
      "fontSize": 52.26094818814565,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a unified, portable, and secure EHR platform that creates a lifelong\ndigital health record for every patient, accessible across all \nhealthcare providers.\n\n- Single Source of Truth: All medical encounters, prescriptions, \n  lab results,and imaging reports stored in one secure profile.\n\n- Patient-Controlled Access: Patients grant temporary access to doctors\n  via OTP.",
      "autoResize": true,
      "lineHeight": 1.25
    },
