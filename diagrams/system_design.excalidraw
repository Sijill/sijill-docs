    {
      "id": "Lwfqp5U_b_vZ9CLAp0Ak5",
      "type": "text",
      "x": 4620.070789181528,
      "y": 5422.6781095368515,
      "width": 2548.8165209845224,
      "height": 613.351391271983,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e03131",
