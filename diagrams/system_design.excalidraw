      "seed": 2005705524,
      "version": 1022,
      "versionNonce": 1272134271,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765005205174,
      "link": null,
      "locked": false,
      "text": "After the HCP reads the patient's medical history the can then create a new encounter\nwhere they record symptoms/diagnosis/prescriped medications\nand they can order lab tests / imaging\n\nthe system automatically creates notifications and reminders for:\n    - next appointment\n    - medications\n    - test order\n    - imaging order",
      "fontSize": 54.52012366862076,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After the HCP reads the patient's medical history the can then create a new encounter\nwhere they record symptoms/diagnosis/prescriped medications\nand they can order lab tests / imaging\n\nthe system automatically creates notifications and reminders for:\n    - next appointment\n    - medications\n    - test order\n    - imaging order",
      "autoResize": true,
      "lineHeight": 1.25
    },
