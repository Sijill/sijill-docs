    {
      "id": "68vtv7VFFCHZbPUSVqWTc",
      "type": "text",
      "x": 801.9817885179953,
      "y": 3937.152075881294,
      "width": 2255.0134449730117,
      "height": 788.4659777535713,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5K",
      "roundness": null,
      "seed": 52182013,
      "version": 378,
      "versionNonce": 1162564337,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765005191767,
      "link": null,
      "locked": false,
      "text": "EHR system is not a new idea, it already exists in developed countries\n\n- USA:  \n\n- UK:\n\n- Estonia:\n\nAnd as Egypt is now heading into its digital transformation era, \nSijill positions itself perfectly as the foundational EHR layer for a modern, \ndata-driven health system.\n",
      "fontSize": 52.56439851690475,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EHR system is not a new idea, it already exists in developed countries\n\n- USA:  \n\n- UK:\n\n- Estonia:\n\nAnd as Egypt is now heading into its digital transformation era, \nSijill positions itself perfectly as the foundational EHR layer for a modern, \ndata-driven health system.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
